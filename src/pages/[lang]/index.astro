---
import SiteLayout from '../../layouts/SiteLayout.astro';
import MotionCard from '../../components/react/MotionCard';
import MetricBadge from '../../components/MetricBadge.astro';
import { COPY, SITE_DESCRIPTION, type Lang } from '../../consts';
import { getPostsByLang } from '../../lib/blog';

export async function getStaticPaths() {
  return [{ params: { lang: 'ko' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const copy = COPY[lang];
const posts = (await getPostsByLang(lang)).slice(0, 3);
---

<SiteLayout lang={lang} title={copy.homeTitle} description={SITE_DESCRIPTION}>
  <section class="grid auto-rows-[180px] gap-4 md:grid-cols-3">
    <div class="card p-6 md:col-span-2">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[hsl(var(--text-muted))]">Research Briefing</p>
      <h1 class="mb-2 mt-2 text-3xl font-bold tracking-tight md:text-4xl">{copy.homeTitle}</h1>
      <p class="text-[hsl(var(--text-muted))]">{copy.homeSubtitle}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <MetricBadge label={lang === 'ko' ? '배포' : 'Deploy'} value="Cloudflare Pages" trend="up" />
        <MetricBadge label={lang === 'ko' ? '리스크' : 'Risk'} value={lang === 'ko' ? '통제됨' : 'Controlled'} trend="flat" />
        <MetricBadge label={lang === 'ko' ? '응답성' : 'Latency'} value={lang === 'ko' ? '최적화 중심' : 'Optimized'} trend="up" />
        <a class="inline-block text-sm font-semibold" href={`/${lang}/blog/`}>{copy.browse} →</a>
      </div>
    </div>
    <div class="card p-6">
      <p class="text-sm text-[hsl(var(--text-muted))]">{copy.latestPosts}</p>
      <p class="mt-2 text-2xl font-bold tabular-nums">{posts.length}</p>
      <div class="mt-4 h-px w-full bg-[hsl(var(--border-subtle))]" />
      <p class="mt-3 text-xs text-[hsl(var(--text-muted))]">Updated regularly with concise market notes</p>
    </div>
    {
      posts.map((post) => (
        <MotionCard client:visible>
          <a href={`/${lang}/blog/${post.id.split('/').slice(1).join('/')}/`} class="card block h-full p-5">
            <p class="text-xs text-[hsl(var(--text-muted))]">{post.data.pubDate.toLocaleDateString(lang)}</p>
            <h2 class="mt-2 text-lg font-semibold text-[hsl(var(--text))]">{post.data.title}</h2>
            <p class="mt-2 text-sm text-[hsl(var(--text-muted))]">{post.data.description}</p>
          </a>
        </MotionCard>
      ))
    }
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-3" aria-label={lang === 'ko' ? '신뢰 정보' : 'Trust information'}>
    <article id="methodology" class="card p-5">
      <h2 class="text-base font-semibold text-[hsl(var(--text-primary))]">{copy.methodologyTitle}</h2>
      <p class="mt-2 text-sm text-[hsl(var(--text-secondary))]">{copy.methodologyBody}</p>
    </article>
    <article id="legal" class="card p-5">
      <h2 class="text-base font-semibold text-[hsl(var(--text-primary))]">{copy.legalTitle}</h2>
      <p class="mt-2 text-sm text-[hsl(var(--text-secondary))]">{copy.legalBody}</p>
    </article>
    <article id="contact" class="card p-5">
      <h2 class="text-base font-semibold text-[hsl(var(--text-primary))]">{copy.contact}</h2>
      <p class="mt-2 text-sm text-[hsl(var(--text-secondary))]">{copy.contactBody}</p>
      <a class="mt-3 inline-flex text-sm font-semibold" href="mailto:hello@example.com">hello@example.com</a>
    </article>
  </section>
</SiteLayout>
