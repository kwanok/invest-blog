---
import { render, getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ReadingProgress from '../../../components/react/ReadingProgress';
import type { Lang } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const [lang, ...rest] = post.id.split('/');
    return {
      params: { lang, slug: rest.join('/') },
      props: { post },
    };
  });
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props;
const { Content } = await render(post);
---

<SiteLayout lang={lang} title={post.data.title} description={post.data.description}>
  <ReadingProgress client:load />
  <article class="prose prose-neutral max-w-[72ch] dark:prose-invert">
    <p class="text-sm text-[hsl(var(--text-muted))] tabular-nums">{post.data.pubDate.toLocaleDateString(lang)}</p>
    <h1 class="text-4xl font-bold">{post.data.title}</h1>
    <Content />
  </article>
</SiteLayout>
