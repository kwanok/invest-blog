---
import { render, getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ReadingProgress from '../../../components/react/ReadingProgress';
import TocSpy from '../../../components/react/TocSpy';
import TagBadge from '../../../components/TagBadge.astro';
import PostTrustPanel from '../../../components/PostTrustPanel.astro';
import RiskNotice from '../../../components/RiskNotice.astro';
import type { Lang } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const [lang, ...rest] = post.id.split('/');
    return {
      params: { lang, slug: rest.join('/') },
      props: { post },
    };
  });
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
---

<SiteLayout lang={lang} title={post.data.title} description={post.data.description}>
  <ReadingProgress client:load />
  <RiskNotice lang={lang} position="top" />
  <div class="grid gap-8 lg:grid-cols-[minmax(0,72ch)_220px] lg:items-start">
    <article class="prose prose-neutral max-w-[72ch] dark:prose-invert">
      <p class="text-sm text-[hsl(var(--text-muted))] tabular-nums">{post.data.pubDate.toLocaleDateString(lang)}</p>
      <h1 class="text-4xl font-bold">{post.data.title}</h1>
      <div class="my-3 flex flex-wrap gap-1">{post.data.postTags.map((tag) => <TagBadge tag={tag} />)}</div>
      <PostTrustPanel lang={lang} post={post} />

      {
        tocHeadings.length > 0 && (
          <details class="card my-5 p-3 lg:hidden">
            <summary class="cursor-pointer text-sm font-semibold text-[hsl(var(--text-primary))]">
              {lang === 'ko' ? '목차 보기' : 'View contents'}
            </summary>
            <ul class="mt-3 space-y-2">
              {tocHeadings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="block rounded px-2 py-1 text-sm text-[hsl(var(--text-secondary))] hover:bg-[hsl(var(--accent-soft))] hover:text-[hsl(var(--text-primary))]"
                    style={`padding-left: calc(${(heading.depth - 2) * 0.65}rem + 0.5rem)`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <Content />
      <p class="mt-6 text-sm text-[hsl(var(--text-secondary))]">
        <a href={`/${lang}/corrections/`}>{lang === 'ko' ? '정정 정책/로그 보기' : 'View corrections policy/log'}</a>
      </p>
      <RiskNotice lang={lang} position="bottom" />
    </article>

    {
      tocHeadings.length > 0 && (
        <aside class="card hidden p-4 lg:sticky lg:top-20 lg:block" aria-label={lang === 'ko' ? '문서 목차' : 'Table of contents'}>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[hsl(var(--text-muted))]">Contents</p>
          <nav>
            <TocSpy client:load headings={tocHeadings} />
          </nav>
        </aside>
      )
    }
  </div>
</SiteLayout>
