---
import { render, getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ReadingProgress from '../../../components/react/ReadingProgress';
import type { Lang } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const [lang, ...rest] = post.id.split('/');
    return {
      params: { lang, slug: rest.join('/') },
      props: { post },
    };
  });
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
---

<SiteLayout lang={lang} title={post.data.title} description={post.data.description}>
  <ReadingProgress client:load />
  <div class="grid gap-8 lg:grid-cols-[minmax(0,72ch)_220px] lg:items-start">
    <article class="prose prose-neutral max-w-[72ch] dark:prose-invert">
      <p class="text-sm text-[hsl(var(--text-muted))] tabular-nums">{post.data.pubDate.toLocaleDateString(lang)}</p>
      <h1 class="text-4xl font-bold">{post.data.title}</h1>
      <Content />
    </article>

    {
      tocHeadings.length > 0 && (
        <aside class="card hidden p-4 lg:sticky lg:top-20 lg:block" aria-label={lang === 'ko' ? '문서 목차' : 'Table of contents'}>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[hsl(var(--text-muted))]">Contents</p>
          <nav>
            <ul class="space-y-2">
              {tocHeadings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="block text-sm text-[hsl(var(--text-secondary))] hover:text-[hsl(var(--text-primary))]"
                    style={`padding-left: ${(heading.depth - 2) * 0.65}rem`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</SiteLayout>
