---
import BaseHead from '../components/BaseHead.astro';
import ThemeToggle from '../components/react/ThemeToggle';
import { COPY, type Lang } from '../consts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const otherLang = lang === 'ko' ? 'en' : 'ko';
const copy = COPY[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{copy.skipToContent}</a>
    <header class="site-header border-b border-[hsl(var(--border))] bg-[hsl(var(--surface))]">
      <div class="container flex flex-wrap items-center justify-between gap-2 py-3 md:py-4">
        <div class="flex min-w-0 items-center gap-3 md:gap-6">
          <a href={`/${lang}/`} class="truncate text-sm font-semibold text-[hsl(var(--text))] md:text-base">Arcane Markets</a>
          <nav aria-label={lang === 'ko' ? '주요 메뉴' : 'Primary'} class="hidden md:block">
            <a class="text-sm font-medium text-[hsl(var(--text-secondary))] hover:text-[hsl(var(--text-primary))]" href={`/${lang}/blog/`}>
              {lang === 'ko' ? '인사이트' : 'Insights'}
            </a>
          </nav>
        </div>
        <div class="ml-auto flex items-center gap-2">
          <a class="card px-2.5 py-2 text-xs text-[hsl(var(--text))] md:px-3 md:text-sm" href={`/${otherLang}/`}>{otherLang.toUpperCase()}</a>
          <ThemeToggle client:load label={copy.toggleTheme} />
        </div>
      </div>
    </header>
    <main id="main-content" class="container py-8">
      <slot />
    </main>
    <footer class="mt-8 border-t border-[hsl(var(--border-subtle))] bg-[hsl(var(--bg-surface))]">
      <div class="container flex flex-col gap-3 py-6 text-sm text-[hsl(var(--text-secondary))] md:flex-row md:items-center md:justify-between">
        <p class="text-xs text-[hsl(var(--text-muted))]">{copy.footerNote}</p>
        <nav aria-label={lang === 'ko' ? '하단 링크' : 'Footer links'} class="flex items-center gap-4">
          <a href={`/${lang}/#methodology`} class="hover:underline">{copy.methodology}</a>
          <a href={`/${lang}/#legal`} class="hover:underline">{copy.legal}</a>
          <a href={`/${lang}/#contact`} class="hover:underline">{copy.contact}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
